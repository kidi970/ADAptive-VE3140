# Normalise line endings so a Windows checkout cannot break the build.
# The Ada_Drivers_Library submodule carries its own .gitattributes; this file
# does not reach into it.
* text=auto

*.adb text eol=lf
*.ads text eol=lf
*.gpr text eol=lf
*.toml text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.patch text eol=lf
*.rules text eol=lf

*.hex text eol=lf
*.bin binary
*.png binary
*.jpg binary

# Preserve captured evidence bytes so its SHA-256 manifest survives cloning.
docs/evidence/2026-10-23-sensors/** -text whitespace=cr-at-eol,-blank-at-eof
docs/evidence/2026-10-23-reference60/** -text whitespace=cr-at-eol,-blank-at-eof
docs/evidence/2026-11-02-readiness/** -text whitespace=cr-at-eol,-blank-at-eof

# A unified diff's empty context line is one literal space; preserve the copy.
docs/code/current/patches/*.patch whitespace=-blank-at-eol
