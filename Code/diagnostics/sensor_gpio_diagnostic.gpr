with "../libs/Ada_Drivers_Library/boards/MicroBit_v2/microbit_v2_full.gpr";
project Sensor_GPIO_Diagnostic is
   for Source_Dirs use (".", "../src");
   for Object_Dir use "obj-gpio";
   for Main use ("sensor_gpio_diagnostic.adb");
   for Target use "arm-eabi";
   for Runtime ("Ada") use "embedded-nrf52833";
   package Compiler is
      for Switches ("Ada") use ("-gnat2022", "-gnateDPROFILING=false", "-g", "-fstack-usage");
   end Compiler;
   package Linker is
      for Switches ("Ada") use ("-g", "-Wl,--print-memory-usage", "-Wl,--defsym=__stack_size=16384");
   end Linker;
end Sensor_GPIO_Diagnostic;
