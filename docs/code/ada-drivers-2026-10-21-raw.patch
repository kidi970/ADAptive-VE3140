diff --git a/boards/MicroBit_v2/src/full/microbit-i2c.adb b/boards/MicroBit_v2/src/full/microbit-i2c.adb
index 7db981ad..2fbf87a9 100644
--- a/boards/MicroBit_v2/src/full/microbit-i2c.adb
+++ b/boards/MicroBit_v2/src/full/microbit-i2c.adb
@@ -31,6 +31,7 @@
 
 with nRF.Device;
 with nRF.TWI;
+with nRF.GPIO;
 
 package body MicroBit.I2C is
 
@@ -71,20 +72,41 @@ package body MicroBit.I2C is
       Init_Done := True;
    end Initialize;
 
+
    procedure InitializeExt (S : Speed := S400kbps) is
    begin
+      -- Configure SCL (P19 / P0.26)
+      MB_SCL_EXT.Configure_IO
+        (Config =>
+           (Mode         => nRF.GPIO.Mode_In,
+            Resistors    => nRF.GPIO.Pull_Up,
+            Input_Buffer => nRF.GPIO.Input_Buffer_Connect,
+            Drive        => nRF.GPIO.Drive_S0D1,
+            Sense        => nRF.GPIO.Sense_Disabled));
+
+      -- Configure SDA (P20 / P1.00)
+      MB_SDA_EXT.Configure_IO
+        (Config =>
+           (Mode         => nRF.GPIO.Mode_In,
+            Resistors    => nRF.GPIO.Pull_Up,
+            Input_Buffer => nRF.GPIO.Input_Buffer_Connect,
+            Drive        => nRF.GPIO.Drive_S0D1,
+            Sense        => nRF.GPIO.Sense_Disabled));
+
+      -- Configure external I2C controller
       DeviceExt.Configure
         (SCL   => MB_SCL_EXT.Pin,
          SDA   => MB_SDA_EXT.Pin,
-         Speed => (case S is
-                      when S100kbps => nRF.TWI.TWI_100kbps,
-                      when S250kbps => nRF.TWI.TWI_250kbps,
-                      when S400kbps => nRF.TWI.TWI_400kbps)
-        );
+         Speed =>
+           (case S is
+              when S100kbps => nRF.TWI.TWI_100kbps,
+              when S250kbps => nRF.TWI.TWI_250kbps,
+              when S400kbps => nRF.TWI.TWI_400kbps));
 
       DeviceExt.Enable;
       Init_DoneExt := True;
    end InitializeExt;
+
    ----------------
    -- Controller --
    ----------------
